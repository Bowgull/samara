#!/bin/sh
# Refuse a push that carries a secret, a personal detail or a banned name: gitleaks over the whole history being
# pushed, then the scrub test. There is no auto-push: pushes are by hand, after these pass.
root="$(git rev-parse --show-toplevel)"
cfg="$root/.gitleaks.toml"
[ -f "$root/.gitleaks.local.toml" ] && cfg="$root/.gitleaks.local.toml"
command -v gitleaks >/dev/null 2>&1 || { echo "pre-push: gitleaks is not installed; push refused." >&2; exit 1; }
gitleaks git --redact --no-banner --config "$cfg" "$root" || { echo "pre-push: gitleaks found something; push refused." >&2; exit 1; }
node --no-warnings --test "$root/test/scrub.test.ts" >/dev/null 2>&1 || { echo "pre-push: the scrub test failed (node --test test/scrub.test.ts); push refused." >&2; exit 1; }
